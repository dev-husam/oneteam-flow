# Copy to .env for local development. Every variable is read in apps/api/src/config/env.ts only.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Public URLs. WEB_BASE_URL is used in e-mail links. CORS_ORIGINS is a comma-separated allow-list.
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# MySQL (docker compose: infra/docker-compose.yml)
DATABASE_URL=mysql://pt:pt_dev_password@localhost:3307/pt_dev

# Redis (queues, rate limits)
REDIS_URL=redis://localhost:6380

# JWT: ES256 key pair in PEM. In development/test an ephemeral pair is generated when unset.
# Generate: pnpm --filter @pt/api gen:keys   (REQUIRED in production)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=dev-1
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Encrypts TOTP secrets at rest: 32 random bytes, base64 (openssl rand -base64 32). Required in production.
MFA_ENCRYPTION_KEY=

# Refresh cookie (web clients). Set COOKIE_DOMAIN to the shared parent domain in staging/production.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# E-mail: smtp (Mailpit locally) or memory (tests)
MAIL_TRANSPORT=smtp
# Feature flags, identity, theme and e-mail templates are managed in the admin console; instances cache them for this many seconds.
CONFIG_CACHE_SECONDS=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Personal Trainer <no-reply@localhost>"

# Number of reverse proxies in front of the API (Caddy = 1). Needed for correct client IPs / rate limits.
TRUST_PROXY=0
RATE_LIMIT_ENABLED=true

# File storage: local (dev) or s3 (R2/S3, required in production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_SIGNING_SECRET=
API_PUBLIC_URL=http://localhost:3001
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Push notifications: expo | memory | off
PUSH_TRANSPORT=off

# Protects /api/v1/health/ready (required in production)
HEALTH_TOKEN=

# OpenAPI docs at /api/docs
SWAGGER_ENABLED=true

# Process role: api | worker | all (all = api + queue consumers in one process, development only)
APP_ROLE=all

# Current terms/privacy document version stored in consent_records
TERMS_VERSION=2026-11-01

# Web app (apps/web). The browser calls the API directly; its origin must be listed in CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

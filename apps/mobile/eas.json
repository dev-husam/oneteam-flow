{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3001/api/v1" } },
    "preview": { "distribution": "internal", "env": { "EXPO_PUBLIC_API_URL": "https://staging-api.example.com/api/v1" } },
    "production": { "autoIncrement": true, "env": { "EXPO_PUBLIC_API_URL": "https://api.example.com/api/v1" } }
  },
  "submit": { "production": {} }
}
